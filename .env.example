# Copy to .env for local development. In production set these in the
# hosting provider's environment variable settings (never commit real values).

# PostgreSQL 15+ connection string
DATABASE_URL=postgresql://user:password@host:5432/masira

# Only this address can request a sign-in link
OWNER_EMAIL=you@example.com

# Public base URL of the app, used to build magic-link URLs
APP_URL=http://localhost:3000

# Resend (https://resend.com) for sending magic-link emails
RESEND_API_KEY=
AUTH_EMAIL_FROM="Masira <login@your-verified-domain.com>"

# Used by @ai-sdk/openai for the chat model
OPENAI_API_KEY=
