// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  conversations Conversation[]
  memories      Memory[]
}

model Conversation {
  id        Int      @id @default(autoincrement())
  title     String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  user     User      @relation(fields: [userId], references: [id])
  userId   Int

  messages Message[]
}

model Message {
  id             Int      @id @default(autoincrement())
  role           String
  content        String
  createdAt      TimestamptzString @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId Int
}

model Memory {
  id        Int      @id @default(autoincrement())
  key       String
  value     String
  category  String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  user   User @relation(fields: [userId], references: [id])
  userId Int
}
model Business {
  id            Int      @id @default(autoincrement())
  name          String
  role          String?
  description   String?
  market        String?
  businessModel String?
  stage         String?
  priority      String?
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  projects Project[]
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  status      String?
  priority    String?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  business   Business @relation(fields: [businessId], references: [id])
  businessId Int

  people ProjectPerson[]

  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  organisationId Int?

}


model Organisation {
  id          Int      @id @default(autoincrement())
  name        String
  type        String?
  description String?
  country     String?
  website     String?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  people Person[]
  projects Project[]
}

model Person {
  id             Int      @id @default(autoincrement())
  name           String
  title          String?
  email          String?
  phone          String?
  role           String?
  notes          String?
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  organisationId Int?

  projects ProjectPerson[]
}


model ProjectPerson {
  id        Int      @id @default(autoincrement())
  role      String?
  notes     String?
  createdAt TimestamptzString @default(now())

  project   Project @relation(fields: [projectId], references: [id])
  projectId Int

  person    Person @relation(fields: [personId], references: [id])
  personId  Int

  @@unique([projectId, personId])

}
